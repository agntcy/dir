# Directory Reconciler Configuration
# Environment variable prefix: RECONCILER

# Database Configuration (PostgreSQL)
RECONCILER_DATABASE_TYPE=postgres
RECONCILER_DATABASE_POSTGRES_HOST=postgres
RECONCILER_DATABASE_POSTGRES_PORT=5432
RECONCILER_DATABASE_POSTGRES_DATABASE=directory
RECONCILER_DATABASE_POSTGRES_USERNAME=postgres
RECONCILER_DATABASE_POSTGRES_PASSWORD=postgres
RECONCILER_DATABASE_POSTGRES_SSL_MODE=disable

# Local Registry Configuration (shared by all tasks)
RECONCILER_LOCAL_REGISTRY_REGISTRY_ADDRESS=zot:5000
RECONCILER_LOCAL_REGISTRY_REPOSITORY_NAME=dir
RECONCILER_LOCAL_REGISTRY_AUTH_CONFIG_USERNAME=
RECONCILER_LOCAL_REGISTRY_AUTH_CONFIG_PASSWORD=
RECONCILER_LOCAL_REGISTRY_AUTH_CONFIG_INSECURE=true

# Apiserver gRPC address — required by the metrics task to query provider counts
# from the routing layer. Must point to the apiserver's gRPC listen address.
RECONCILER_SERVER_ADDRESS=apiserver:8888

# Metrics Task Configuration
# Refreshes provider_count in record_usage_metrics by querying the DHT routing layer.
RECONCILER_METRICS_ENABLED=true
RECONCILER_METRICS_INTERVAL=1m

# Regsync Task Configuration
# Synchronizes records from remote registries using regsync command
RECONCILER_REGSYNC_ENABLED=true
RECONCILER_REGSYNC_INTERVAL=1m
RECONCILER_REGSYNC_TIMEOUT=10m

# Authentication for remote Directory connections (registry credentials provider)
# Modes: "jwt" or "x509"
RECONCILER_REGSYNC_AUTHN_ENABLED=false
RECONCILER_REGSYNC_AUTHN_MODE=x509
RECONCILER_REGSYNC_AUTHN_SOCKET_PATH=
RECONCILER_REGSYNC_AUTHN_AUDIENCES=

# Indexer Task Configuration
# Indexes records from local registry into search database
RECONCILER_INDEXER_ENABLED=true
RECONCILER_INDEXER_INTERVAL=1m

# Signature Task Configuration
# Verifies record signatures and caches results for the API
RECONCILER_SIGNATURE_ENABLED=true
RECONCILER_SIGNATURE_INTERVAL=1m
RECONCILER_SIGNATURE_TTL=168h
RECONCILER_SIGNATURE_RECORD_TIMEOUT=30s

# Identity Task Configuration
# Verifies the identity and ownership claims attached to records against the
# key material their subjects publish.
RECONCILER_IDENTITY_ENABLED=false
RECONCILER_IDENTITY_INTERVAL=1h
RECONCILER_IDENTITY_RECORD_TIMEOUT=1m
# The ans:// scheme trusts an Agent Name Service transparency log on a public
# address; with ALLOW_UNPINNED_ROOT_KEYS trust rests on TLS to the trusted
# hosts alone. Lists are comma-separated. Leave these commented unless the
# scheme is wanted: a set value overrides reconciler.config.yml, and an empty
# duration fails startup.
# RECONCILER_IDENTITY_ANS_ENABLED=true
# RECONCILER_IDENTITY_ANS_TRUSTED_LOG_HOSTS=log.example.com
# RECONCILER_IDENTITY_ANS_ROOT_KEYS=example-log+1a2b3c4d+AjBZ...
# RECONCILER_IDENTITY_ANS_ALLOW_UNPINNED_ROOT_KEYS=false
# RECONCILER_IDENTITY_ANS_ROOT_KEYS_TTL=10m
# RECONCILER_IDENTITY_ANS_TIMEOUT=10s
# RECONCILER_IDENTITY_ANS_STATUS_CACHE_TTL=30s
# RECONCILER_IDENTITY_ANS_STALE_GRACE=24h
# RECONCILER_IDENTITY_ANS_CLOCK_SKEW=30s

# Scan Task Configuration
# Runs mcp-scanner and skill-scanner against record artifacts and stores results.
RECONCILER_SCAN_ENABLED=true
RECONCILER_SCAN_INTERVAL=1m
RECONCILER_SCAN_TTL=168h
RECONCILER_SCAN_RECORD_TIMEOUT=5m
RECONCILER_SCAN_MCP_CLI_PATH=mcp-scanner
RECONCILER_SCAN_SKILL_CLI_PATH=skill-scanner

# Policy Task Configuration
# Evaluates records against content policies and stores the verdicts read paths
# filter on. Off: no policy evaluator is implemented yet.
RECONCILER_POLICY_EVALUATION_ENABLED=false
RECONCILER_POLICY_EVALUATION_INTERVAL=1m
RECONCILER_POLICY_EVALUATION_RECORD_TIMEOUT=30s
RECONCILER_POLICY_EVALUATION_BATCH_SIZE=500

# Prune Task Configuration
# Deletes records that match criteria (trusted, min_severity, older_than).
# Disabled by default because it deletes records.
RECONCILER_PRUNE_ENABLED=false
RECONCILER_PRUNE_INTERVAL=30m
RECONCILER_PRUNE_RECORD_TIMEOUT=30s
RECONCILER_PRUNE_CRITERIA_TRUSTED=false
RECONCILER_PRUNE_CRITERIA_MIN_SEVERITY=MEDIUM
RECONCILER_PRUNE_CRITERIA_OLDER_THAN=168h
RECONCILER_PRUNE_LIMIT=100
RECONCILER_PRUNE_DRY_RUN=true

# Azure OpenAI credentials — required for security scanning
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Logger Configuration (shared across components)
# Log levels: DEBUG, INFO, WARN, ERROR
# Log formats: json, text
DIRECTORY_LOGGER_LOG_LEVEL=DEBUG
DIRECTORY_LOGGER_LOG_FORMAT=json
